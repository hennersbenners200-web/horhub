<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    {%- liquid
      assign page_title_full = page_title
      if current_tags
        assign tags_joined = current_tags | join: ', '
        assign page_title_full = page_title_full | append: ' – ' | append: tags_joined
      endif
      if current_page != 1
        assign page_title_full = page_title_full | append: ' – Page ' | append: current_page
      endif
      unless page_title contains shop.name
        assign page_title_full = page_title_full | append: ' | ' | append: shop.name
      endunless
    -%}
    <title>{{ page_title_full }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="{{ settings.seo_brand_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign heading_bold = settings.font_heading | font_modify: 'weight', 'bolder'
      assign body_medium = settings.font_body | font_modify: 'weight', '500'
      assign body_bold = settings.font_body | font_modify: 'weight', 'bold'
    -%}
    {{ settings.font_heading | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ settings.font_body | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    <style>
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ heading_bold | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ body_medium | font_face: font_display: 'swap' }}
      {{ body_bold | font_face: font_display: 'swap' }}

      :root {
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};

        --c-bg: {{ settings.color_background }};
        --c-surface: {{ settings.color_surface }};
        --c-text: {{ settings.color_text }};
        --c-accent: {{ settings.color_accent }};
        --c-accent-rgb: {{ settings.color_accent.red }} {{ settings.color_accent.green }} {{ settings.color_accent.blue }};
        --c-on-accent: {{ settings.color_accent_text }};
        --c-light-bg: {{ settings.color_light_background }};
        --logo-width: {{ settings.logo_width }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>

    {% render 'structured-data-organization' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handleize }}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <script>
      window.theme = {
        cartType: {{ settings.cart_type | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          error: {{ 'cart.error' | t | json }}
        }
      };
    </script>
  </body>
</html>
