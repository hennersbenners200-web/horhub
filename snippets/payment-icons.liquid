{%- comment -%} Payment method icons, taken from the payment methods enabled in Shopify Payments / checkout settings. {%- endcomment -%}
{%- if shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons" role="list" aria-label="{{ 'general.payment_methods' | t }}">
    {%- for type in shop.enabled_payment_types -%}
      <li>{{ type | payment_type_svg_tag }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
