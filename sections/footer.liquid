<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {% render 'wordmark' %}
        {%- if section.settings.brand_text != blank -%}
          <p>{{ section.settings.brand_text }}</p>
        {%- endif -%}
        {% render 'social-icons' %}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="footer__cols">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'menu' -%}
                  <h2 class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- when 'support' -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                  <ul class="footer__links" role="list">
                    {%- if block.settings.email != blank -%}
                      <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                    {%- endif -%}
                    {%- if block.settings.hours != blank -%}
                      <li class="muted">{{ block.settings.hours }}</li>
                    {%- endif -%}
                    <li><a href="{{ block.settings.contact_page.url | default: '/pages/contact' }}">{{ 'general.contact_us' | t }}</a></li>
                  </ul>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="footer__newsletter">
          <h2 class="h3">{{ section.settings.newsletter_heading }}</h2>
          {%- if section.settings.newsletter_text != blank -%}<p>{{ section.settings.newsletter_text }}</p>{%- endif -%}
          {%- form 'customer', id: 'FooterNewsletter', class: 'footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              <div class="newsletter-form">
                <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
                <input
                  class="input"
                  id="FooterNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="{{ 'newsletter.placeholder' | t }}"
                  required
                  {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}
                >
                <button type="submit" class="btn btn--primary">{{ 'newsletter.button' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="form-message form-message--error footer__newsletter-error" id="FooterNewsletterError" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    {%- if settings.legal_notice != blank -%}
      <div class="footer__legal">
        {% render 'icon', name: 'info' %}
        <div class="rte">{{ settings.legal_notice }}</div>
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ 'general.rights' | t }}</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {% render 'payment-icons' %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Wireless programmable car horns for drivers who want their car to sound like theirs."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true,
      "info": "Subscribers appear in Customers with email marketing consent."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "New sounds, first."
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Sound pack drops, install guides and launch offers. No spam — unsubscribe any time."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the menu name." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "support",
      "name": "Support",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Support" },
        { "type": "text", "id": "email", "label": "Support email", "placeholder": "support@yourstore.com" },
        { "type": "text", "id": "hours", "label": "Support hours", "default": "Mon–Fri, 9am–5pm" },
        { "type": "page", "id": "contact_page", "label": "Contact page" }
      ]
    }
  ]
}
{% endschema %}
