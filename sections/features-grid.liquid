<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <ul class="features" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-card" {{ block.shopify_attributes }}>
          <span class="feature-card__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p class="feature-card__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features grid",
  "tag": "div",
  "max_blocks": 9,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "surface", "label": "Dark grey" },
        { "value": "light", "label": "Light" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why HornHub" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered to be fun. Built to last." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "truck", "label": "Truck"}, {"value": "return", "label": "Returns"}, {"value": "shield", "label": "Shield"}, {"value": "support", "label": "Support"}, {"value": "wireless", "label": "Wireless"}, {"value": "bluetooth", "label": "Bluetooth"}, {"value": "sliders", "label": "Sliders"}, {"value": "sound", "label": "Speaker"}, {"value": "music", "label": "Music"}, {"value": "wave", "label": "Waveform"}, {"value": "wrench", "label": "Wrench"}, {"value": "car", "label": "Car"}, {"value": "bolt", "label": "Power"}, {"value": "droplet", "label": "Weather"}, {"value": "phone", "label": "Phone"}, {"value": "clock", "label": "Clock"}, {"value": "lock", "label": "Lock"}, {"value": "box", "label": "Box"}, {"value": "button", "label": "Button"}, {"value": "gauge", "label": "Gauge"}, {"value": "layers", "label": "Layers"}, {"value": "star", "label": "Star"}, {"value": "globe", "label": "Globe"}, {"value": "scale", "label": "Legal"}, {"value": "mail", "label": "Email"}, {"value": "info", "label": "Info"}, {"value": "check-circle", "label": "Check"}], "default": "wireless" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the benefit in one or two short sentences." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "wireless", "title": "Truly wireless control", "text": "The button talks to the horn unit wirelessly, so there's nothing to run through your dash." } },
        { "type": "feature", "settings": { "icon": "phone", "title": "App-based sound control", "text": "Browse, preview and assign sounds from your phone. Change them as often as you like." } },
        { "type": "feature", "settings": { "icon": "droplet", "title": "Weather-sealed housing", "text": "Designed to live in the engine bay through rain, road spray and heat." } },
        { "type": "feature", "settings": { "icon": "bolt", "title": "12V plug-in harness", "text": "Connects to your car's 12V supply using the included wiring and fuse." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Factory horn stays", "text": "HornHub adds a second voice. Your original horn keeps working exactly as before." } },
        { "type": "feature", "settings": { "icon": "support", "title": "Install support", "text": "Clear guides and a real support team if you get stuck." } }
      ]
    }
  ]
}
{% endschema %}
