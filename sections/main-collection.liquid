<section class="scheme-dark page-section">
  <div class="container">
    <header class="collection-header section-head">
      <p class="eyebrow">{{ 'collections.shop' | t }}</p>
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lead rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.per_page -%}
      <div class="collection-toolbar">
        <p>{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        {%- if collection.products_count > 1 -%}
          <form method="get" action="{{ collection.url }}">
            <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
            <select class="select" id="SortBy" name="sort_by" data-auto-submit>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit" class="btn btn--sm btn--secondary">{{ 'collections.apply' | t }}</button></noscript>
          </form>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <ul class="product-grid{% if collection.products.size == 1 %} product-grid--single{% endif %}" role="list">
          {%- for product in collection.products -%}
            <li>
              {%- if collection.products.size == 1 -%}
                {% render 'product-card', product: product, sizes: '(min-width: 750px) 520px, 100vw', eager: true %}
              {%- else -%}
                {% render 'product-card', product: product, eager: forloop.first %}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="not-found">
          <p class="h3">{{ 'collections.empty' | t }}</p>
          <div class="cta-row"><a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>
        </div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12 }
  ]
}
{% endschema %}
