<section class="scheme-dark page-section">
  <div class="container container--narrow">
    <header class="page-header">
      <h1 class="h1">{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label class="visually-hidden" for="SearchInput">{{ 'search.label' | t }}</label>
        <input class="input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="btn btn--primary">{{ 'general.search' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        <p class="muted" role="status">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
        {%- if search.results_count > 0 -%}
          <ul class="search-results" role="list">
            {%- for item in search.results -%}
              <li>
                <a class="search-result" href="{{ item.url }}">
                  <span class="search-result__media">
                    {%- assign result_image = item.featured_image | default: item.image -%}
                    {%- if result_image -%}
                      {{ result_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 72, height: 72 }}
                    {%- endif -%}
                  </span>
                  <span>
                    <span class="h4">{{ item.title }}</span>
                    {%- if item.object_type == 'product' -%}
                      {% render 'price', product: item %}
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "div"
}
{% endschema %}
