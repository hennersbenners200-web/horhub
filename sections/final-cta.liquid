{%- assign product = section.settings.product -%}
<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="final-cta__box">
      <div class="final-cta__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h1" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}

        {%- if product != blank -%}
          {% render 'price', product: product, size: 'lg' %}
          {%- if product.has_only_default_variant -%}
            {%- assign form_id = 'FinalCtaForm-' | append: section.id -%}
            {% render 'product-form', product: product, form_id: form_id, button_label: section.settings.button_label %}
          {%- else -%}
            <a class="btn btn--primary btn--lg" href="{{ product.url }}">{{ 'products.choose_options' | t }}</a>
          {%- endif -%}
        {%- else -%}
          <a class="btn btn--primary btn--lg" href="{{ routes.all_products_collection_url }}">{{ 'products.shop_now' | t }}</a>
        {%- endif -%}

        {%- assign assurances = section.settings.assurances | newline_to_br | split: '<br />' -%}
        {%- if section.settings.assurances != blank -%}
          <ul class="final-cta__assurances" role="list">
            {%- for line in assurances -%}
              {%- assign line_text = line | strip -%}
              {%- if line_text != blank -%}<li>{% render 'icon', name: 'check' %}{{ line_text }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="final-cta__media">
        <div class="media">
          {%- assign cta_image = section.settings.image | default: product.featured_image -%}
          {% render 'media',
            image: cta_image,
            sizes: '(min-width: 990px) 40vw, 100vw',
            file: 'final-cta-kit-contents.jpg (1600 × 1600px)',
            description: 'Everything in the HornHub box laid out flat: the horn unit and the wireless 4-button remote.'
          %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final call to action",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "surface", "label": "Dark grey" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Square, 1600 × 1600px. Falls back to the product image." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready when you are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give your car something to say." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A 130dB horn unit and a wireless 4-button remote, ready for your own sounds. Order now and give your car a voice of its own." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    {
      "type": "textarea",
      "id": "assurances",
      "label": "Assurances (one per line)",
      "default": "Free tracked shipping\n30-day hassle-free returns\n12-month warranty\nSecure checkout"
    }
  ],
  "presets": [{ "name": "Final call to action" }]
}
{% endschema %}
