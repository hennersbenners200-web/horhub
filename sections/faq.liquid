<section class="section scheme-{{ section.settings.scheme }}" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container faq__grid">
    <div class="faq__aside">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.contact_heading != blank -%}
        <div class="faq__contact">
          <p class="h4">{{ section.settings.contact_heading }}</p>
          {%- if section.settings.contact_text != blank -%}<p class="muted small">{{ section.settings.contact_text }}</p>{%- endif -%}
          <a class="link-arrow" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      {%- endif -%}
    </div>

    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question }}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "surface", "label": "Dark grey" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq", "info": "Menu links to /#faq scroll here." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Everything you need to know before you order." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "checkbox", "id": "structured_data", "label": "Add FAQ structured data for search engines", "default": true, "info": "Use on one FAQ section per page only." },
    { "type": "header", "content": "Contact box" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Still not sure?" },
    { "type": "text", "id": "contact_text", "label": "Text", "default": "Send us your car's make, model and year and we'll confirm the fit." },
    { "type": "text", "id": "contact_label", "label": "Link label", "default": "Ask our team" },
    { "type": "url", "id": "contact_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Will HornHub work with my car?", "answer": "<p>HornHub is designed for vehicles with a standard 12V electrical system, which covers most cars, vans and pickups. If you're unsure, contact us with your make, model and year before ordering and we'll confirm.</p>" } },
        { "type": "question", "settings": { "question": "How hard is it to install?", "answer": "<p>If you can locate your battery and use a screwdriver, you can install HornHub. The kit includes a wiring harness, inline fuse and a step-by-step guide. Most installs take 30–60 minutes. If you'd rather not do it yourself, any auto electrician can fit it quickly.</p>" } },
        { "type": "question", "settings": { "question": "How does the wireless button connect?", "answer": "<p>The button pairs wirelessly with the horn unit, so there are no cables to run into the cabin. Pairing takes a minute during setup and the button reconnects automatically after that.</p>" } },
        { "type": "question", "settings": { "question": "What powers it?", "answer": "<p>The horn unit runs from your car's 12V supply using the included harness and fuse. The wireless button uses a replaceable coin-cell battery.</p>" } },
        { "type": "question", "settings": { "question": "Can I use my own sounds?", "answer": "<p>Yes. Choose from the built-in library or load your own short audio clips through the app, then assign them to the button. You can change sounds as often as you like.</p>" } },
        { "type": "question", "settings": { "question": "Is it waterproof?", "answer": "<p>The horn unit has a weather-sealed housing designed for the engine bay, where it's exposed to rain and road spray. It isn't designed to be submerged, and we recommend mounting it away from direct water jets when pressure washing.</p>" } },
        { "type": "question", "settings": { "question": "Does it replace my factory horn?", "answer": "<p>No. HornHub is installed alongside your original horn, which keeps working as normal. That means you always have your standard horn available.</p>" } },
        { "type": "question", "settings": { "question": "Is it legal to use?", "answer": "<p>Rules on vehicle horns and sound devices vary by country, state and region. In many places, horns may only be used to warn other road users, and some sounds or volumes are restricted on public roads. Please check your local regulations before installing or using HornHub. You are responsible for using it lawfully and considerately.</p>" } },
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders are dispatched within 1 working day with tracking. Delivery times and costs for your location are shown at checkout.</p>" } },
        { "type": "question", "settings": { "question": "What if I don't like it?", "answer": "<p>You have 30 days from delivery to return it. Contact us and we'll guide you through the return. See our refund policy for the full details.</p>" } }
      ]
    }
  ]
}
{% endschema %}
