{%- liquid
  assign product = section.settings.product
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}
<section class="hero scheme-{{ section.settings.scheme }}{% if section.settings.full_height %} hero--full{% endif %}" aria-labelledby="Hero-{{ section.id }}">
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="h-display hero__title" id="Hero-{{ section.id }}">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}<br><em>{{ section.settings.heading_accent }}</em>{%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="lead hero__sub">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="cta-row">
        {%- if section.settings.primary_label != blank -%}
          <a class="btn btn--primary btn--lg" href="{{ section.settings.primary_link | default: product.url | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn btn--secondary btn--lg" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if rating != blank and section.settings.show_rating -%}
        <p class="hero__rating">
          {% render 'rating', rating: rating.rating %}
          <span><strong>{{ rating.rating | round: 1 }}/5</strong> · {{ 'products.review_count' | t: count: rating_count }}</span>
        </p>
      {%- endif -%}

      {%- liquid
        assign has_points = false
        if section.settings.point_1 != blank or section.settings.point_2 != blank or section.settings.point_3 != blank
          assign has_points = true
        endif
      -%}
      {%- if has_points -%}
        <ul class="hero__points" role="list">
          {%- if section.settings.point_1 != blank -%}<li>{% render 'icon', name: 'check' %}{{ section.settings.point_1 }}</li>{%- endif -%}
          {%- if section.settings.point_2 != blank -%}<li>{% render 'icon', name: 'check' %}{{ section.settings.point_2 }}</li>{%- endif -%}
          {%- if section.settings.point_3 != blank -%}<li>{% render 'icon', name: 'check' %}{{ section.settings.point_3 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero__media">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="media">
        {%- assign hero_image = section.settings.image | default: product.featured_image -%}
        {% render 'media',
          image: hero_image,
          sizes: '(min-width: 990px) 50vw, 100vw',
          eager: true,
          file: 'hero-hornhub-kit.jpg (1600 × 2000px)',
          description: 'HornHub horn unit and wireless button on a dark surface, lit from the side with a warm orange rim light.'
        %}
      </div>
      {%- if product != blank and section.settings.show_product_tag -%}
        <a class="hero__tag" href="{{ product.url }}">
          <span>
            <span class="hero__tag-label">{{ section.settings.product_tag_label }}</span><br>
            <span class="hero__tag-title">{{ product.title }}</span>
          </span>
          {% render 'price', product: product %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "surface", "label": "Dark grey" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    { "type": "checkbox", "id": "full_height", "label": "Fill screen height on desktop", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wireless programmable car horn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your car." },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent line)", "default": "Your sound." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Swap the flat factory beep for any sound you want. Pick it on your phone, tap the wireless button, and let the street hear it."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "primary_link", "label": "Primary button link", "info": "Defaults to the featured product below." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "See how it works" },
    { "type": "text", "id": "secondary_link", "label": "Secondary button link", "default": "#how-it-works", "info": "A URL, or #how-it-works to scroll to that section." },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, 1600 × 2000px. Falls back to the product's main image." },
    { "type": "product", "id": "product", "label": "Featured product", "info": "Shows live price and rating." },
    { "type": "checkbox", "id": "show_product_tag", "label": "Show product price tag on image", "default": true },
    { "type": "text", "id": "product_tag_label", "label": "Price tag label", "default": "The complete kit" },
    { "type": "checkbox", "id": "show_rating", "label": "Show product rating", "default": true, "info": "Appears only once a reviews app has published ratings to the product." },
    { "type": "header", "content": "Key points" },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Fits most 12V cars" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Simple DIY install" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "30-day returns" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
