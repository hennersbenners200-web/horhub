{%- assign product = section.settings.product -%}
<section class="section showcase scheme-{{ section.settings.scheme }}{% if section.settings.reverse %} showcase--reverse{% endif %}" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container showcase__grid">
    <div class="showcase__media">
      <div class="media">
        {%- assign showcase_image = section.settings.image | default: product.media[1].preview_image | default: product.featured_image -%}
        {% render 'media',
          image: showcase_image,
          sizes: '(min-width: 990px) 50vw, 100vw',
          file: 'showcase-horn-unit.jpg (1800 × 1800px)',
          description: 'Close-up of the Viral Horn unit and wireless 4-button remote side by side, showing size, connectors and build quality.'
        %}
      </div>
    </div>

    <div class="showcase__content">
      <div class="section-head section-head--flush">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="showcase__features" role="list">
          {%- for block in section.blocks -%}
            <li class="feature-row" {{ block.shopify_attributes }}>
              <span class="feature-row__icon">{% render 'icon', name: block.settings.icon %}</span>
              <div>
                <h3 class="feature-row__title h4">{{ block.settings.title }}</h3>
                <p class="feature-row__text">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if product != blank -%}
        <div class="showcase__buy">
          {% render 'price', product: product, size: 'lg' %}
          {%- if product.has_only_default_variant -%}
            {%- assign form_id = 'ShowcaseForm-' | append: section.id -%}
            {% render 'product-form', product: product, form_id: form_id %}
          {%- else -%}
            <a class="btn btn--primary btn--lg" href="{{ product.url }}">{{ 'products.choose_options' | t }}</a>
          {%- endif -%}
          <a class="link-arrow" href="{{ product.url }}">{{ 'products.full_details' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "surface", "label": "Dark grey" },
        { "value": "light", "label": "Light" }
      ],
      "default": "surface"
    },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right (desktop)", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "product", "info": "Link to this section with #product." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Square, 1800 × 1800px. Falls back to the product's second image." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet the Viral Horn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A horn you program like a playlist." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A powerful 130dB horn unit that plays the sounds you load onto it, and a wireless 4-button remote that puts them at your fingertips."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "truck", "label": "Truck"}, {"value": "return", "label": "Returns"}, {"value": "shield", "label": "Shield"}, {"value": "support", "label": "Support"}, {"value": "wireless", "label": "Wireless"}, {"value": "bluetooth", "label": "Bluetooth"}, {"value": "sliders", "label": "Sliders"}, {"value": "sound", "label": "Speaker"}, {"value": "music", "label": "Music"}, {"value": "wave", "label": "Waveform"}, {"value": "wrench", "label": "Wrench"}, {"value": "car", "label": "Car"}, {"value": "bolt", "label": "Power"}, {"value": "droplet", "label": "Weather"}, {"value": "phone", "label": "Phone"}, {"value": "clock", "label": "Clock"}, {"value": "lock", "label": "Lock"}, {"value": "box", "label": "Box"}, {"value": "button", "label": "Button"}, {"value": "gauge", "label": "Gauge"}, {"value": "layers", "label": "Layers"}, {"value": "star", "label": "Star"}, {"value": "globe", "label": "Globe"}, {"value": "scale", "label": "Legal"}, {"value": "mail", "label": "Email"}, {"value": "info", "label": "Info"}, {"value": "check-circle", "label": "Check"}], "default": "wireless" },
        { "type": "text", "id": "title", "label": "Title", "default": "Wireless 4-button remote" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Trigger your sounds instantly. No wires to run into the cabin." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        { "type": "feature", "settings": { "icon": "wireless", "title": "Wireless 4-button remote", "text": "Trigger your sounds instantly. No wires to run into the cabin." } },
        { "type": "feature", "settings": { "icon": "sliders", "title": "Your own sounds", "text": "Load any MP3 or WAV file via USB. Funny, loud or completely ridiculous." } },
        { "type": "feature", "settings": { "icon": "music", "title": "130dB output", "text": "Built to make itself heard, not politely ignored." } },
        { "type": "feature", "settings": { "icon": "wrench", "title": "Simple installation", "text": "Designed to work alongside your existing horn, so you keep your factory horn too." } },
        { "type": "feature", "settings": { "icon": "car", "title": "Broad compatibility", "text": "Designed for 12V vehicles. Check your fit in the FAQ." } }
      ]
    }
  ]
}
{% endschema %}
