<section class="section scheme-{{ section.settings.scheme }}" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <ol class="steps" role="list">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          {%- if section.settings.show_images -%}
            <div class="step__media">
              {% render 'media',
                image: block.settings.image,
                sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 50vw, 100vw',
                file: block.settings.placeholder_file,
                description: block.settings.title
              %}
            </div>
          {%- endif -%}
          <span class="step__num">{{ 'sections.step' | t: number: forloop.index }}</span>
          <h3 class="h3">{{ block.settings.title }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
          {%- if block.settings.time != blank -%}
            <span class="step__time">{% render 'icon', name: 'clock' %}{{ block.settings.time }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank or section.settings.note != blank -%}
      <div class="steps__footer">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--primary btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="small muted">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "surface", "label": "Dark grey" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "how-it-works", "info": "Menu links to /#how-it-works scroll here." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From box to beep in four steps." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "No garage, no specialist tools, no guesswork. Every kit includes a step-by-step guide." },
    { "type": "checkbox", "id": "show_images", "label": "Show step images", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get yours" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note", "default": "Stuck mid-install? Our support team will walk you through it." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "4:3, 1200 × 900px." },
        { "type": "text", "id": "placeholder_file", "label": "Suggested image filename", "info": "Shown on the placeholder until you upload an image.", "default": "step-image.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Connect" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pair the horn with the HornHub app over Bluetooth." },
        { "type": "text", "id": "time", "label": "Time estimate", "default": "1 min" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "placeholder_file": "step-1-connect.jpg", "title": "Connect", "text": "Download the app and pair your horn unit and wireless button.", "time": "2 min" } },
        { "type": "step", "settings": { "placeholder_file": "step-2-choose-sound.jpg", "title": "Choose your sound", "text": "Pick from the built-in library or load your own clips, then assign them to the button.", "time": "5 min" } },
        { "type": "step", "settings": { "placeholder_file": "step-3-install.jpg", "title": "Install", "text": "Mount the unit under the bonnet and connect it to 12V power with the included harness.", "time": "30–60 min" } },
        { "type": "step", "settings": { "placeholder_file": "step-4-use-it.jpg", "title": "Use it", "text": "Place the wireless button within reach. Tap once, and your sound plays.", "time": "Instant" } }
      ]
    }
  ]
}
{% endschema %}
