{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}
<section class="product-main scheme-dark" id="MainProduct-{{ section.id }}">
  <div class="container product-main__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    <product-gallery class="product-gallery" aria-label="{{ 'products.gallery' | t }}">
      <div class="product-gallery__viewport">
        <ul class="product-gallery__track" role="list" data-gallery-track>
          {%- if media_count == 0 -%}
            <li class="product-gallery__slide">
              {% render 'media', file: 'product-main.jpg (2000 × 2000px)', description: 'HornHub kit product photo on a seamless dark background.' %}
            </li>
          {%- endif -%}
          {%- for media in product.media -%}
            <li class="product-gallery__slide" data-media-id="{{ media.id }}">
              {%- assign media_alt = media.alt | default: product.title -%}
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}
                    {{ media | image_url: width: 2000 | image_tag: sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1500, 2000', loading: 'eager', fetchpriority: 'high', alt: media_alt }}
                  {%- else -%}
                    {{ media | image_url: width: 2000 | image_tag: sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1500, 2000', loading: 'lazy', alt: media_alt }}
                  {%- endif -%}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1100x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: loading: 'lazy' }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if media_count > 1 -%}
          <div class="product-gallery__nav">
            <button type="button" class="product-gallery__arrow" data-gallery-step="-1" aria-label="{{ 'products.previous_media' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
            <span class="product-gallery__counter" aria-hidden="true"><span data-gallery-current>1</span> / {{ media_count }}</span>
            <button type="button" class="product-gallery__arrow" data-gallery-step="1" aria-label="{{ 'products.next_media' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
          </div>
        {%- endif -%}
      </div>
      {%- if media_count > 1 -%}
        <ul class="product-gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="product-gallery__thumb" data-thumb="{{ media.id }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'products.show_media' | t: number: forloop.index }}">
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 100, height: 100 }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </product-gallery>

    {%- comment -%} Purchase column {%- endcomment -%}
    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>

          {%- when 'eyebrow' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

          {%- when 'title' -%}
            <h1 class="product-info__title h1" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'rating' -%}
            {%- if rating != blank -%}
              <a class="product-info__rating" href="#reviews" {{ block.shopify_attributes }}>
                {% render 'rating', rating: rating.rating %}
                <span>{{ rating.rating | round: 1 }} · {{ 'products.review_count' | t: count: rating_count }}</span>
              </a>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product-info__price" data-variant-region="{{ section.id }}" data-region="price" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, size: 'lg' %}
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="xsmall muted">
                  {%- if cart.taxes_included -%}{{ 'products.tax_included' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} {{ 'products.shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="product-info__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'highlights' -%}
            {%- assign highlight_lines = block.settings.items | newline_to_br | split: '<br />' -%}
            <ul class="product-info__highlights" role="list" {{ block.shopify_attributes }}>
              {%- for line in highlight_lines -%}
                {%- assign line_text = line | strip -%}
                {%- if line_text != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ line_text }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <variant-picker class="variant-picker" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variant-picker__option">
                    <legend class="variant-picker__legend">
                      {{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span>
                    </legend>
                    <div class="variant-picker__values">
                      {%- for value in option.values -%}
                        <input
                          type="radio"
                          class="visually-hidden"
                          id="{{ section.id }}-{{ option.position }}-{{ forloop.index }}"
                          name="{{ option.name | escape }}-{{ section.id }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="variant-pill" for="{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants-json>
                  {{ product.variants | json }}
                </script>
              </variant-picker>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="product-info__buy" id="BuyButtons-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'product-form',
                product: product,
                form_id: form_id,
                show_quantity: block.settings.show_quantity,
                show_dynamic_checkout: block.settings.show_dynamic_checkout
              %}
              {%- if block.settings.trust_note != blank -%}
                <p class="product-info__secure">{% render 'icon', name: 'lock' %}{{ block.settings.trust_note }}</p>
              {%- endif -%}
            </div>

          {%- when 'trust_badges' -%}
            <ul class="product-trust" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- liquid
                  assign icon_key = 'icon_' | append: i
                  assign title_key = 'title_' | append: i
                  assign text_key = 'text_' | append: i
                -%}
                {%- if block.settings[title_key] != blank -%}
                  <li class="product-trust__item">
                    {% render 'icon', name: block.settings[icon_key] %}
                    <span><strong>{{ block.settings[title_key] }}</strong><span>{{ block.settings[text_key] }}</span></span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'delivery' -%}
            <div class="product-delivery" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'truck' %}
              <div>
                <p class="product-delivery__title">{{ block.settings.title }}</p>
                {%- if block.settings.text != blank -%}<p class="small muted">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </div>

          {%- when 'legal' -%}
            {%- assign legal_text = block.settings.text | default: settings.legal_notice -%}
            {%- if legal_text != blank -%}
              <div class="product-legal" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'info' %}
                <div class="rte">{{ legal_text }}</div>
              </div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- liquid
              assign tab_content = block.settings.content
              if block.settings.source == 'description'
                assign tab_content = product.description
              elsif block.settings.page != blank
                assign tab_content = block.settings.page.content
              endif
            -%}
            {%- if tab_content != blank -%}
              <details class="accordion__item product-tab" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  <span class="product-tab__label">{% render 'icon', name: block.settings.icon %}{{ block.settings.heading }}</span>
                  <span class="accordion__icon" aria-hidden="true"></span>
                </summary>
                <div class="accordion__content rte">{{ tab_content }}</div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Sticky purchase bar — appears once the main buy buttons scroll out of view {%- endcomment -%}
  <sticky-buy-bar class="sticky-buy" data-watch="BuyButtons-{{ section.id }}" inert>
    <div class="container sticky-buy__inner">
      <div class="sticky-buy__product">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48, class: 'sticky-buy__thumb' }}
        {%- endif -%}
        <div>
          <p class="sticky-buy__title">{{ product.title }}</p>
          <div data-variant-region="{{ section.id }}" data-region="sticky-price">
            {% render 'price', product: product, variant: current_variant %}
          </div>
        </div>
      </div>
      <button type="submit" form="{{ form_id }}" class="btn btn--primary sticky-buy__button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
        <span data-add-label>{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
      </button>
    </div>
  </sticky-buy-bar>
</section>

{% render 'structured-data-product', product: product %}

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Wireless programmable car horn" }]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [{ "type": "paragraph", "content": "Shows the rating your reviews app publishes to this product." }] },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Swap the flat factory beep for any sound you want. Load your own MP3s and fire them from a wireless 4-button remote at up to 130dB.</p>" }]
    },
    {
      "type": "highlights",
      "name": "Highlights",
      "limit": 1,
      "settings": [{ "type": "textarea", "id": "items", "label": "Highlights (one per line)", "default": "Load your own MP3 or WAV sounds via USB\nWireless 4-button remote\nPowerful 130dB output\nWorks alongside your existing horn\nDesigned for 12V vehicles" }]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show accelerated checkout buttons", "default": true, "info": "Shows Shop Pay, Apple Pay, Google Pay etc. when enabled in your payment settings." },
        { "type": "text", "id": "trust_note", "label": "Note under buttons", "default": "Secure checkout · Encrypted payment" }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "icon_1", "label": "Badge 1 icon", "options": [{"value": "truck", "label": "Truck"}, {"value": "return", "label": "Returns"}, {"value": "shield", "label": "Shield"}, {"value": "support", "label": "Support"}, {"value": "wireless", "label": "Wireless"}, {"value": "bluetooth", "label": "Bluetooth"}, {"value": "sliders", "label": "Sliders"}, {"value": "sound", "label": "Speaker"}, {"value": "music", "label": "Music"}, {"value": "wave", "label": "Waveform"}, {"value": "wrench", "label": "Wrench"}, {"value": "car", "label": "Car"}, {"value": "bolt", "label": "Power"}, {"value": "droplet", "label": "Weather"}, {"value": "phone", "label": "Phone"}, {"value": "clock", "label": "Clock"}, {"value": "lock", "label": "Lock"}, {"value": "box", "label": "Box"}, {"value": "button", "label": "Button"}, {"value": "gauge", "label": "Gauge"}, {"value": "layers", "label": "Layers"}, {"value": "star", "label": "Star"}, {"value": "globe", "label": "Globe"}, {"value": "scale", "label": "Legal"}, {"value": "mail", "label": "Email"}, {"value": "info", "label": "Info"}, {"value": "check-circle", "label": "Check"}], "default": "truck" },
        { "type": "text", "id": "title_1", "label": "Badge 1 title", "default": "Free shipping" },
        { "type": "text", "id": "text_1", "label": "Badge 1 text", "default": "Tracked delivery" },
        { "type": "select", "id": "icon_2", "label": "Badge 2 icon", "options": [{"value": "truck", "label": "Truck"}, {"value": "return", "label": "Returns"}, {"value": "shield", "label": "Shield"}, {"value": "support", "label": "Support"}, {"value": "wireless", "label": "Wireless"}, {"value": "bluetooth", "label": "Bluetooth"}, {"value": "sliders", "label": "Sliders"}, {"value": "sound", "label": "Speaker"}, {"value": "music", "label": "Music"}, {"value": "wave", "label": "Waveform"}, {"value": "wrench", "label": "Wrench"}, {"value": "car", "label": "Car"}, {"value": "bolt", "label": "Power"}, {"value": "droplet", "label": "Weather"}, {"value": "phone", "label": "Phone"}, {"value": "clock", "label": "Clock"}, {"value": "lock", "label": "Lock"}, {"value": "box", "label": "Box"}, {"value": "button", "label": "Button"}, {"value": "gauge", "label": "Gauge"}, {"value": "layers", "label": "Layers"}, {"value": "star", "label": "Star"}, {"value": "globe", "label": "Globe"}, {"value": "scale", "label": "Legal"}, {"value": "mail", "label": "Email"}, {"value": "info", "label": "Info"}, {"value": "check-circle", "label": "Check"}], "default": "return" },
