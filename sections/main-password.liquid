<section class="scheme-dark password">
  <div class="container container--narrow not-found">
    {% render 'wordmark' %}
    <h1 class="h1">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lead">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
          <input class="input" id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
          <button type="submit" class="btn btn--primary">{{ 'newsletter.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="small muted">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter-form">
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button type="submit" class="btn btn--secondary">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something loud is coming." }
  ]
}
{% endschema %}
