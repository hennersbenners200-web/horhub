    "faq": {
      "type": "faq",
      "blocks": {
        "faq-question-1": {
          "type": "question",
          "settings": {
            "question": "Will the Viral Horn work with my car?",
            "answer": "<p>The Viral Horn is designed for vehicles with a 12V electrical system, which covers most cars, vans and pickups. If you're unsure, contact us with your make, model and year before ordering and we'll confirm.</p>"
          }
        },
        "faq-question-2": {
          "type": "question",
          "settings": {
            "question": "How hard is it to install?",
            "answer": "<p>The Viral Horn is designed for simple installation. It connects to your car's 12V supply and works alongside your existing horn. If you're not confident with car electrics, any auto electrician can fit it for you.</p>"
          }
        },
        "faq-question-3": {
          "type": "question",
          "settings": {
            "question": "How does the wireless remote work?",
            "answer": "<p>The 4-button remote talks to the horn unit wirelessly, so there are no cables to run into the cabin. Press a button and the sound you've chosen plays instantly.</p>"
          }
        },
        "faq-question-4": {
          "type": "question",
          "settings": {
            "question": "What powers it?",
            "answer": "<p>The horn unit runs from your car's 12V electrical supply.</p>"
          }
        },
        "faq-question-5": {
          "type": "question",
          "settings": {
            "question": "Can I use my own sounds?",
            "answer": "<p>Yes, that's the whole point. Load your own MP3 or WAV files via USB and trigger them from the wireless remote. Change them as often as you like.</p>"
          }
        },
        "faq-question-6": {
          "type": "question",
          "settings": {
            "question": "Where should I mount it?",
            "answer": "<p>Mount the horn unit in a protected spot in the engine bay, away from direct water spray and hot engine parts, and avoid pointing a pressure washer straight at it.</p>"
          }
        },
        "faq-question-7": {
          "type": "question",
          "settings": {
            "question": "Does it replace my factory horn?",
            "answer": "<p>No. The Viral Horn is installed alongside your original horn, which keeps working as normal. That means you always have your standard horn available.</p>"
          }
        },
        "faq-question-8": {
          "type": "question",
          "settings": {
            "question": "Is it legal to use?",
            "answer": "<p>Rules on vehicle horns and sound devices vary by country, state and region. In many places, horns may only be used to warn other road users, and some sounds or volumes are restricted on public roads. The Viral Horn is very loud (up to 130dB), so use it considerately and never near people's ears. Please check your local regulations before installing or using it. You are responsible for using it lawfully.</p>"
          }
        },
        "faq-question-9": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are dispatched within 1 working day with tracking. Delivery times and costs for your location are shown at checkout.</p>"
          }
        },
        "faq-question-10": {
          "type": "question",
          "settings": {
            "question": "What if I don't like it?",
            "answer": "<p>You have 30 days from delivery to return it. Contact us and we'll guide you through the return. See our refund policy for the full details.</p>"
          }
        }
      },
